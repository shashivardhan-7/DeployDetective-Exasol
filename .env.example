# Exasol Personal connection
EXASOL_HOST=localhost
EXASOL_PORT=8563
EXASOL_USER=SYS
EXASOL_PASSWORD=change-me
EXASOL_SCHEMA=DEPLOY_DETECTIVE

# TLS: 1 = encrypted + certificate validation, 0 = local/dev exception only
EXASOL_SSL_VERIFY=1

# FastAPI
APP_HOST=127.0.0.1
APP_PORT=8000

# Optional narrative enhancement. The core investigation does NOT depend on an LLM.
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
